TOKEN_EOF = -1.0
TOKEN_NUMBER = 0.0
TOKEN_IDENT = 1.0
TOKEN_PLUS = 2.0
TOKEN_MINUS = 3.0
TOKEN_STAR = 4.0
TOKEN_SLASH = 5.0
TOKEN_ASSIGN = 7.0
TOKEN_NEWLINE = 22.0

CHAR_EOF = -1.0
CHAR_SPACE = 32.0
CHAR_NEWLINE = 10.0
CHAR_PLUS = 43.0
CHAR_MINUS = 45.0
CHAR_STAR = 42.0
CHAR_SLASH = 47.0
CHAR_ASSIGN = 61.0
CHAR_ZERO = 48.0
CHAR_NINE = 57.0
CHAR_A_LOWER = 97.0
CHAR_Z_LOWER = 122.0

lexer_source = 0
lexer_pos = 0.0
lexer_length = 0.0
lexer_token_value = 0.0

func lexer_set_source(source):
    lexer_source = source
    lexer_pos = 0.0
    lexer_length = string_len(source)

func lexer_current_char():
    if lexer_pos < lexer_length:
        return string_char_code_at(lexer_source, lexer_pos)
    return CHAR_EOF

func lexer_advance():
    lexer_pos = lexer_pos + 1.0

func lexer_is_digit():
    ch = lexer_current_char()
    if ch >= CHAR_ZERO:
        if ch <= CHAR_NINE:
            return 1.0
    return 0.0

func lexer_is_alpha():
    ch = lexer_current_char()
    if ch >= CHAR_A_LOWER:
        if ch <= CHAR_Z_LOWER:
            return 1.0
    return 0.0

func lexer_skip_whitespace():
    ch = lexer_current_char()
    while ch == CHAR_SPACE:
        lexer_advance()
        ch = lexer_current_char()

func lexer_read_number():
    result = 0.0
    while lexer_is_digit() > 0.0:
        digit = lexer_current_char() - CHAR_ZERO
        result = result * 10.0 + digit
        lexer_advance()
    lexer_token_value = result
    return TOKEN_NUMBER

func lexer_read_ident():
    start = lexer_pos
    while lexer_is_alpha() > 0.0:
        lexer_advance()
    length = lexer_pos - start
    lexer_token_value = string_substring(lexer_source, start, length)
    return TOKEN_IDENT

func lexer_next_token():
    lexer_skip_whitespace()
    ch = lexer_current_char()
    
    if ch == CHAR_EOF: return TOKEN_EOF
    if ch == CHAR_NEWLINE:
        lexer_advance()
        return TOKEN_NEWLINE
    if ch == CHAR_PLUS:
        lexer_advance()
        return TOKEN_PLUS
    if ch == CHAR_MINUS:
        lexer_advance()
        return TOKEN_MINUS
    if ch == CHAR_STAR:
        lexer_advance()
        return TOKEN_STAR
    if ch == CHAR_SLASH:
        lexer_advance()
        return TOKEN_SLASH
    if ch == CHAR_ASSIGN:
        lexer_advance()
        return TOKEN_ASSIGN
    if lexer_is_digit() > 0.0:
        return lexer_read_number()
    if lexer_is_alpha() > 0.0:
        return lexer_read_ident()
    lexer_advance()
    return TOKEN_EOF
