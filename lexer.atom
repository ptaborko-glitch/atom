// lexer.atom — Лексер языка Atom, написанный на Atom
// Этап 5: Self-hosting

// ============================================================
// КОНСТАНТЫ ТОКЕНОВ
// ============================================================
TOKEN_EOF = -1.0
TOKEN_NUMBER = 0.0
TOKEN_IDENT = 1.0
TOKEN_PLUS = 2.0
TOKEN_MINUS = 3.0
TOKEN_STAR = 4.0
TOKEN_SLASH = 5.0
TOKEN_AT = 6.0
TOKEN_ASSIGN = 7.0
TOKEN_EQ = 8.0
TOKEN_NEQ = 9.0
TOKEN_LT = 10.0
TOKEN_GT = 11.0
TOKEN_LTE = 12.0
TOKEN_GTE = 13.0
TOKEN_LPAREN = 14.0
TOKEN_RPAREN = 15.0
TOKEN_LBRACKET = 16.0
TOKEN_RBRACKET = 17.0
TOKEN_COLON = 18.0
TOKEN_COMMA = 19.0
TOKEN_DOT = 20.0
TOKEN_ARROW = 21.0
TOKEN_NEWLINE = 22.0
TOKEN_KW_AGENT = 23.0
TOKEN_KW_ACT = 24.0
TOKEN_KW_GRAPH = 25.0
TOKEN_KW_RETURN = 26.0
TOKEN_KW_IF = 27.0
TOKEN_KW_ELSE = 28.0
TOKEN_KW_WHILE = 29.0
TOKEN_KW_FOR = 30.0
TOKEN_KW_SPAWN = 31.0
TOKEN_KW_SELF = 32.0
TOKEN_KW_FUNC = 33.0

// ============================================================
// КОНСТАНТЫ СИМВОЛОВ
// ============================================================
CHAR_EOF = -1.0
CHAR_SPACE = 32.0
CHAR_TAB = 9.0
CHAR_NEWLINE = 10.0
CHAR_PLUS = 43.0
CHAR_MINUS = 45.0
CHAR_STAR = 42.0
CHAR_SLASH = 47.0
CHAR_AT = 64.0
CHAR_ASSIGN = 61.0
CHAR_BANG = 33.0
CHAR_LT = 60.0
CHAR_GT = 62.0
CHAR_LPAREN = 40.0
CHAR_RPAREN = 41.0
CHAR_LBRACKET = 91.0
CHAR_RBRACKET = 93.0
CHAR_COLON = 58.0
CHAR_COMMA = 44.0
CHAR_DOT = 46.0
CHAR_QUOTE = 34.0
CHAR_UNDERSCORE = 95.0
CHAR_ZERO = 48.0
CHAR_NINE = 57.0
CHAR_A_UPPER = 65.0
CHAR_Z_UPPER = 90.0
CHAR_A_LOWER = 97.0
CHAR_Z_LOWER = 122.0

// ============================================================
// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ЛЕКСЕРА
// ============================================================
lexer_source = ""
lexer_pos = 0.0
lexer_length = 0.0
lexer_line = 1.0
lexer_col = 1.0
lexer_token_value = 0.0

// ============================================================
// ИНИЦИАЛИЗАЦИЯ
// ============================================================

func lexer_set_source:
    lexer_source = ""
    lexer_pos = 0.0
    lexer_length = 0.0
    lexer_line = 1.0
    lexer_col = 1.0
    lexer_token_value = 0.0

// ============================================================
// БАЗОВЫЕ ОПЕРАЦИИ
// ============================================================

func lexer_current_char:
    if lexer_pos < lexer_length:
        ch = string_char_code_at(lexer_source, lexer_pos)
        return ch
    else:
        return CHAR_EOF

func lexer_advance:
    lexer_pos = lexer_pos + 1.0
    lexer_col = lexer_col + 1.0

func lexer_peek:
    next_pos = lexer_pos + 1.0
    if next_pos < lexer_length:
        ch = string_char_code_at(lexer_source, next_pos)
        return ch
    else:
        return CHAR_EOF

// ============================================================
// ПРОВЕРКИ СИМВОЛОВ
// ============================================================

func lexer_is_digit:
    ch = lexer_current_char()
    if ch >= CHAR_ZERO:
        if ch <= CHAR_NINE:
            return 1.0
    return 0.0

func lexer_is_alpha:
    ch = lexer_current_char()
    if ch >= CHAR_A_LOWER:
        if ch <= CHAR_Z_LOWER:
            return 1.0
    if ch >= CHAR_A_UPPER:
        if ch <= CHAR_Z_UPPER:
            return 1.0
    if ch == CHAR_UNDERSCORE:
        return 1.0
    return 0.0

func lexer_is_alnum:
    if lexer_is_digit() > 0.0:
        return 1.0
    if lexer_is_alpha() > 0.0:
        return 1.0
    return 0.0

// ============================================================
// ПРОПУСК ПРОБЕЛОВ
// ============================================================

func lexer_skip_whitespace:
    ch = lexer_current_char()
    while ch == CHAR_SPACE:
        lexer_advance()
        ch = lexer_current_char()
    while ch == CHAR_TAB:
        lexer_advance()
        ch = lexer_current_char()

// ============================================================
// ЧТЕНИЕ ЧИСЛА
// ============================================================

func lexer_read_number:
    result = 0.0
    ch = lexer_current_char()
    while lexer_is_digit() > 0.0:
        digit = ch - CHAR_ZERO
        result = result * 10.0 + digit
        lexer_advance()
        ch = lexer_current_char()
    lexer_token_value = result
    return TOKEN_NUMBER

// ============================================================
// ЧТЕНИЕ ИДЕНТИФИКАТОРА
// ============================================================

func lexer_read_ident:
    lexer_advance()
    ch = lexer_current_char()
    while lexer_is_alnum() > 0.0:
        lexer_advance()
        ch = lexer_current_char()
    return TOKEN_IDENT

// ============================================================
// ГЛАВНАЯ ФУНКЦИЯ: СЛЕДУЮЩИЙ ТОКЕН
// ============================================================

func lexer_next_token:
    lexer_skip_whitespace()

    ch = lexer_current_char()

    if ch == CHAR_EOF:
        return TOKEN_EOF

    if ch == CHAR_NEWLINE:
        lexer_advance()
        lexer_line = lexer_line + 1.0
        lexer_col = 1.0
        return TOKEN_NEWLINE

    if ch == CHAR_PLUS:
        lexer_advance()
        return TOKEN_PLUS

    if ch == CHAR_MINUS:
        lexer_advance()
        next_ch = lexer_current_char()
        if next_ch == CHAR_GT:
            lexer_advance()
            return TOKEN_ARROW
        return TOKEN_MINUS

    if ch == CHAR_STAR:
        lexer_advance()
        return TOKEN_STAR

    if ch == CHAR_SLASH:
        lexer_advance()
        return TOKEN_SLASH

    if ch == CHAR_AT:
        lexer_advance()
        return TOKEN_AT

    if ch == CHAR_ASSIGN:
        lexer_advance()
        next_ch = lexer_current_char()
        if next_ch == CHAR_ASSIGN:
            lexer_advance()
            return TOKEN_EQ
        return TOKEN_ASSIGN

    if ch == CHAR_BANG:
        lexer_advance()
        next_ch = lexer_current_char()
        if next_ch == CHAR_ASSIGN:
            lexer_advance()
            return TOKEN_NEQ
        return TOKEN_EOF

    if ch == CHAR_LT:
        lexer_advance()
        next_ch = lexer_current_char()
        if next_ch == CHAR_ASSIGN:
            lexer_advance()
            return TOKEN_LTE
        return TOKEN_LT

    if ch == CHAR_GT:
        lexer_advance()
        next_ch = lexer_current_char()
        if next_ch == CHAR_ASSIGN:
            lexer_advance()
            return TOKEN_GTE
        return TOKEN_GT

    if ch == CHAR_LPAREN:
        lexer_advance()
        return TOKEN_LPAREN

    if ch == CHAR_RPAREN:
        lexer_advance()
        return TOKEN_RPAREN

    if ch == CHAR_LBRACKET:
        lexer_advance()
        return TOKEN_LBRACKET

    if ch == CHAR_RBRACKET:
        lexer_advance()
        return TOKEN_RBRACKET

    if ch == CHAR_COLON:
        lexer_advance()
        return TOKEN_COLON

    if ch == CHAR_COMMA:
        lexer_advance()
        return TOKEN_COMMA

    if ch == CHAR_DOT:
        lexer_advance()
        return TOKEN_DOT

    if ch == CHAR_QUOTE:
        lexer_advance()
        return TOKEN_IDENT

    if lexer_is_digit() > 0.0:
        return lexer_read_number()

    if lexer_is_alpha() > 0.0:
        return lexer_read_ident()

    lexer_advance()
    return TOKEN_EOF