TOKEN_EOF = -1.0
TOKEN_NUMBER = 0.0
TOKEN_IDENT = 1.0
TOKEN_PLUS = 2.0
TOKEN_ASSIGN = 7.0

CHAR_EOF = -1.0
CHAR_SPACE = 32.0
CHAR_PLUS = 43.0
CHAR_ASSIGN = 61.0
CHAR_ZERO = 48.0
CHAR_NINE = 57.0
CHAR_A_LOWER = 97.0
CHAR_Z_LOWER = 122.0

lexer_source = 0
lexer_pos = 0.0
lexer_length = 0.0

func lexer_set_source:
    lexer_source = source
    lexer_pos = 0.0
    lexer_length = string_len(source)

func lexer_current_char:
    if lexer_pos < lexer_length:
        return string_char_code_at(lexer_source, lexer_pos)
    return CHAR_EOF

func lexer_advance:
    lexer_pos = lexer_pos + 1.0

func lexer_next_token:
    ch = lexer_current_char()
    
    if ch == CHAR_EOF:
        return TOKEN_EOF
    
    lexer_advance()
    
    if ch == CHAR_PLUS:
        return TOKEN_PLUS
    if ch == CHAR_ASSIGN:
        return TOKEN_ASSIGN
    if ch >= CHAR_ZERO and ch <= CHAR_NINE:
        return TOKEN_NUMBER
    if ch >= CHAR_A_LOWER and ch <= CHAR_Z_LOWER:
        return TOKEN_IDENT
    
    return TOKEN_EOF
