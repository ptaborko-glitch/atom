TOKEN_EOF = -1.0
TOKEN_NUMBER = 0.0
TOKEN_IDENT = 1.0
TOKEN_PLUS = 2.0
TOKEN_MINUS = 3.0
TOKEN_STAR = 4.0
TOKEN_SLASH = 5.0
TOKEN_ASSIGN = 7.0
TOKEN_COLON = 18.0
TOKEN_NEWLINE = 22.0
TOKEN_KW_RETURN = 26.0
TOKEN_KW_FUNC = 33.0

current_token = 0.0
token_value = 0.0

func next_token:
    current_token = lexer_next_token()
    token_value = lexer_token_value
    return current_token

func eat(expected):
    if current_token != expected:
        return 0.0
    return next_token()

func peek(expected):
    return current_token == expected

func parse_number:
    value = token_value
    eat(TOKEN_NUMBER)
    return value

func parse_identifier:
    name = token_value
    eat(TOKEN_IDENT)
    return name

func parse_primary:
    if peek(TOKEN_NUMBER):
        return parse_number()
    if peek(TOKEN_IDENT):
        return parse_identifier()
    return 0.0

func parse_expression:
    return parse_primary()

func parse_statement:
    if peek(TOKEN_IDENT):
        name = token_value
        eat(TOKEN_IDENT)
        if peek(TOKEN_ASSIGN):
            eat(TOKEN_ASSIGN)
            value = parse_expression()
            return value
    if peek(TOKEN_KW_RETURN):
        eat(TOKEN_KW_RETURN)
        return parse_expression()
    return 0.0

func parse_program:
    next_token()
    result = 0.0
    while not peek(TOKEN_EOF):
        while peek(TOKEN_NEWLINE):
            eat(TOKEN_NEWLINE)
        if peek(TOKEN_EOF):
            break
        result = parse_statement()
    return result

func parse:
    return parse_program()
